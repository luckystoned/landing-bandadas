---
interface Props {
  href: string;
  variant?: "primary" | "secondary" | "ghost";
  label?: string;
  event?: string;
}

const { href, variant = "primary", label, event } = Astro.props;
const isExternal = /^https?:\/\//.test(href);

const variants = {
  primary:
    "border-ink bg-ink text-white hover:bg-white hover:text-ink",
  secondary:
    "border-line bg-white/70 text-ink hover:border-ink hover:bg-ink hover:text-white",
  ghost:
    "border-transparent bg-transparent text-ink underline-offset-4 hover:underline"
};
---

<a
  class:list={[
    "inline-flex min-h-11 items-center justify-center rounded-md border px-5 py-3 text-sm font-semibold transition-colors duration-200",
    variants[variant]
  ]}
  href={href}
  target={isExternal ? "_blank" : undefined}
  rel={isExternal ? "noopener noreferrer" : undefined}
  aria-label={label}
  data-track-event={event}
  data-track-label={label}
>
  <slot />
</a>
