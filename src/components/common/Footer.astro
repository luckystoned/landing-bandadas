---
import { links, site } from "../../content/bandadas";
---

<footer class="bg-ink px-5 py-10 text-white md:px-10 lg:px-16">
  <div class="mx-auto max-w-content">
    <div class="grid gap-10 border-b border-white/20 pb-10 lg:grid-cols-[1fr_auto] lg:items-end">
      <div>
        <a class="inline-flex" href="/" aria-label="Bandadas, inicio">
          <img
            class="h-7 w-auto md:h-8"
            src="/assets/images/logo-bandadas.png"
            width="1196"
            height="137"
            alt="Bandadas"
            loading="lazy"
            decoding="async"
          />
        </a>
        <p class="mt-3 max-w-md text-white/65">Arte, tecnología y gestión para construir desarrollos con identidad.</p>
      </div>
      <div class="flex flex-wrap gap-x-6 gap-y-3 text-sm font-semibold">
        <a href={links.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
        <a href={links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href={links.terms} target="_blank" rel="noopener noreferrer">Términos</a>
        <a href={links.privacy} target="_blank" rel="noopener noreferrer">Privacidad</a>
      </div>
    </div>
    <div class="mt-7 flex flex-col gap-2 text-sm text-white/55 sm:flex-row sm:justify-between">
      <p>© {new Date().getFullYear()} Bandadas. Todos los derechos reservados.</p>
      <p>{site.location}</p>
    </div>
  </div>
</footer>
