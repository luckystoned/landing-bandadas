---
import SectionShell from "../components/common/SectionShell.astro";
import { endorsements, faqs } from "../content/bandadas";
---

<SectionShell id="nosotros" eyebrow="El equipo" title="Gestión cultural y estrategia de marca, trabajando juntas.">
  <div class="grid gap-5 lg:grid-cols-2">
    <article class="min-h-80 bg-pink p-7 md:p-10">
      <p class="text-sm font-black uppercase tracking-[0.14em]">Gestión cultural</p>
      <p class="mt-20 max-w-lg text-3xl font-black leading-tight tracking-[-0.04em] md:text-4xl">Experiencia en arte contemporáneo, convocatorias, jurados y producción.</p>
    </article>
    <article class="min-h-80 bg-electric p-7 text-white md:p-10">
      <p class="text-sm font-black uppercase tracking-[0.14em]">Marketing y comunicación</p>
      <p class="mt-20 max-w-lg text-3xl font-black leading-tight tracking-[-0.04em] md:text-4xl">Estrategia para convertir cada etapa del premio en posicionamiento.</p>
    </article>
  </div>

  <div class="mt-24 grid gap-10 lg:grid-cols-[15rem_1fr]">
    <p class="section-eyebrow">Bandadas cuenta con el aval de</p>
    <ul class="divide-y divide-ink border-y border-ink">
      {endorsements.map((endorsement, index) => (
        <li class="grid gap-3 py-5 sm:grid-cols-[3rem_1fr]">
          <span class="font-black text-electric">0{index + 1}</span>
          <span class="font-semibold">{endorsement}</span>
        </li>
      ))}
    </ul>
  </div>
</SectionShell>

<SectionShell id="preguntas" eyebrow="Preguntas frecuentes" title="Lo necesario para empezar una conversación." theme="dark">
  <div class="ml-auto max-w-4xl divide-y divide-white/25 border-y border-white/25">
    {faqs.map((item, index) => (
      <details class="faq group py-6">
        <summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-xl font-bold md:text-2xl">
          <span><span class="mr-4 text-pink">0{index + 1}</span>{item.question}</span>
          <span class="transition-transform group-open:rotate-45" aria-hidden="true">+</span>
        </summary>
        <p class="max-w-2xl pb-2 pt-5 leading-relaxed text-white/68 md:pl-12">{item.answer}</p>
      </details>
    ))}
  </div>
</SectionShell>
