---
import SectionShell from "../components/common/SectionShell.astro";
import ButtonLink from "../components/ui/ButtonLink.astro";
import { gesCase, links, references } from "../content/bandadas";
---

<SectionShell id="caso-ges" eyebrow="Caso de éxito" title="Arte, patrimonio y resultados concretos.">
  <article class="overflow-hidden border border-ink">
    <div class="grid gap-10 bg-ink p-7 text-white md:p-10 lg:grid-cols-2 lg:gap-16 lg:p-12">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-pink">{gesCase.status}</p>
        <h3 class="mt-6 text-4xl font-black leading-[0.95] tracking-[-0.05em] md:text-5xl">{gesCase.title}</h3>
        <p class="mt-7 text-lg leading-relaxed text-white/80">{gesCase.text}</p>
        <div class="mt-8 border-t border-white/25 pt-6">
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-pink">Ganadora · Edición 2026</p>
          <p class="mt-3 text-3xl font-bold tracking-[-0.04em]">{gesCase.winner}</p>
          <p class="mt-3 leading-relaxed text-white/80">{gesCase.result}</p>
          <p class="mt-2 text-sm text-white/70">{gesCase.nextStep}</p>
        </div>
      </div>
      <div class="border-t border-white/25 pt-8 lg:border-l lg:border-t-0 lg:pl-12 lg:pt-0">
        <h4 class="section-eyebrow text-pink">Valor para la marca GES</h4>
        <p class="mt-5 text-2xl font-bold leading-tight tracking-[-0.03em]">{gesCase.brandTitle}</p>
        <p class="mt-5 leading-relaxed text-white/80">{gesCase.brandText}</p>
        <div class="mt-8 border-y border-white/25 py-6">
          <p class="text-6xl font-black tracking-[-0.06em] text-pink">{gesCase.press.value}</p>
          <p class="mt-3 font-bold">{gesCase.press.label}</p>
          <p class="mt-2 text-sm leading-relaxed text-white/80">{gesCase.press.text}</p>
        </div>
        <div class="mt-8">
          <ButtonLink href={links.gesCase.href} event={links.gesCase.event} label={links.gesCase.label} variant="secondary">Conocer el caso <span aria-hidden="true">↗</span></ButtonLink>
        </div>
      </div>
    </div>
    <dl class="grid grid-cols-2 lg:grid-cols-4">
      {gesCase.metrics.map((metric) => (
        <div class="border-t border-ink p-5 md:p-8">
          <dt class="text-sm font-semibold leading-snug">{metric.label}</dt>
          <dd class="mt-4 text-5xl font-black tracking-[-0.06em] text-electric md:text-6xl">{metric.value}</dd>
        </div>
      ))}
    </dl>
  </article>

  <div class="mt-24 grid gap-8 lg:grid-cols-[15rem_1fr]">
    <div>
      <p class="section-eyebrow">Escena local</p>
      <p class="mt-4 text-sm leading-relaxed text-stone">Referentes independientes del mercado. No son proyectos realizados por Bandadas.</p>
    </div>
    <div class="grid border-t border-ink md:grid-cols-3">
      {references.map((reference, index) => (
        <article class="reference-card flex min-h-72 flex-col justify-between border-b border-ink py-7 md:border-r md:px-6 first:md:pl-0 last:md:border-r-0 last:md:pr-0" data-track-event="view_market_reference" data-track-label={reference.name}>
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.14em] text-stone">{reference.note}</p>
            <p class="mt-4 text-5xl font-black text-electric">0{index + 1}</p>
          </div>
          <div>
            <h3 class="text-2xl font-black tracking-[-0.04em]">{reference.name}</h3>
            <p class="mt-2 text-sm text-stone">{reference.artist}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</SectionShell>
