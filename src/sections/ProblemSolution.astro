---
import SectionShell from "../components/common/SectionShell.astro";
import { outcomes, problems, value } from "../content/bandadas";
---

<SectionShell id="problema" eyebrow="El contexto" title="Un mercado saturado necesita nuevas formas de construir valor.">
  <div class="grid border-y border-ink lg:grid-cols-3">
    {problems.map((problem) => (
      <article class="problem-card py-8 lg:px-7 lg:py-10 first:lg:pl-0 last:lg:pr-0">
        <p class="text-sm font-black text-electric">{problem.number}</p>
        <h3 class="mt-8 text-2xl font-bold tracking-[-0.03em]">{problem.title}</h3>
        <p class="mt-4 max-w-sm leading-relaxed text-graphite">{problem.text}</p>
      </article>
    ))}
  </div>
</SectionShell>

<SectionShell id="solucion" eyebrow="Nuestra solución" title={value.title} theme="blue">
  <div class="grid gap-px overflow-hidden border border-white/30 bg-white/30 lg:grid-cols-2">
    {value.pillars.map((pillar, index) => (
      <article class:list={["min-h-80 p-7 md:p-10", index === 0 ? "bg-electric" : "bg-ink"]}>
        <p class="text-sm font-bold uppercase tracking-[0.14em] text-white/60">0{index + 1}</p>
        <h3 class="mt-16 max-w-md text-4xl font-black leading-[0.95] tracking-[-0.05em] md:text-5xl">{pillar.title}</h3>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/72">{pillar.text}</p>
      </article>
    ))}
  </div>

  <div class="mt-24 grid gap-10 lg:grid-cols-[15rem_1fr]">
    <p class="section-eyebrow text-white/65">¿Qué hacemos juntos?</p>
    <ul class="grid gap-x-10 gap-y-0 md:grid-cols-2">
      {outcomes.map((outcome, index) => (
        <li class="flex gap-5 border-t border-white/30 py-5 text-lg leading-snug">
          <span class="font-black text-pink">{String(index + 1).padStart(2, "0")}</span><span>{outcome}</span>
        </li>
      ))}
    </ul>
  </div>
</SectionShell>
