---
import Header from "../components/common/Header.astro";
import Footer from "../components/common/Footer.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Página no encontrada | Bandadas"
  description="La página solicitada no existe. Conocé cómo Bandadas gestiona premios de arte para desarrollos inmobiliarios."
  canonical="/404/"
>
  <Header />
  <main id="contenido" class="px-5 py-24 md:px-10 lg:px-16">
    <section class="mx-auto max-w-content">
      <p class="section-eyebrow">Error 404</p>
      <h1 class="mt-4 max-w-4xl text-[clamp(2.5rem,6vw,5rem)] font-black leading-tight tracking-[-0.05em] text-ink">
        Página no encontrada
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-graphite">
        La página solicitada no existe. Volvé a la landing de Bandadas.
      </p>
      <a class="mt-8 inline-flex min-h-11 items-center rounded-md border border-ink bg-ink px-5 py-3 text-sm font-semibold text-white" href="/">
        Volver al inicio
      </a>
    </section>
  </main>
  <Footer />
</BaseLayout>
